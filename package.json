{
  "name": "stm32f1-emu",
  "version": "0.1.0",
  "description": "Full-system WASM emulator for the STM32F1 family (STM32F103 Blue Pill, F105, etc.) - run Arduino/STM32 firmware in Node.js or the browser",
  "type": "module",
  "main": "./pkg/emulator.js",
  "types": "./pkg/stm32_bluepill_wasm.d.ts",
  "exports": {
    ".": {
      "types": "./pkg/stm32_bluepill_wasm.d.ts",
      "import": "./pkg/emulator.js"
    },
    "./cli": "./pkg/cli.mjs",
    "./wasm": "./pkg/stm32_bluepill_wasm.js"
  },
  "bin": {
    "stm32f1-emu": "./pkg/cli.mjs",
    "bluepill-emu": "./pkg/cli.mjs"
  },
  "files": [
    "pkg/",
    "svd/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg",
    "test": "node tests/test_all.mjs",
    "bench": "node tests/bench.mjs",
    "prepublishOnly": "node tests/test_all.mjs"
  },
  "keywords": [
    "stm32",
    "bluepill",
    "stm32f103",
    "emulator",
    "wasm",
    "arduino",
    "arm",
    "cortex-m3",
    "unicorn"
  ],
  "author": "Danish",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danish9661/STM32-Bluepill-emu.git"
  },
  "bugs": {
    "url": "https://github.com/danish9661/STM32-Bluepill-emu/issues"
  },
  "homepage": "https://github.com/danish9661/STM32-Bluepill-emu#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "ws": "^8.21.3"
  }
}
